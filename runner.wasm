€��€�A€Í2à     uniform mat4 u_projection;     attribute vec2 a_position;     attribute vec4 a_color;     attribute vec2 a_texCoord;     varying vec2 v_texCoord;     varying vec4 v_color;         void main()     {         v_texCoord = a_texCoord;         gl_Position = u_projection * vec4(a_position, 0.0, 1.0);        gl_PointSize = 1.0;         v_color = a_color;     } �������     precision mediump float;     varying vec4 v_color;         void main()     {         gl_FragColor = v_color;     } ��������     precision mediump float;     uniform sampler2D u_texture;     varying vec4 v_color;     varying vec2 v_texCoord;         void main()     {         gl_FragColor = texture2D(u_texture, v_texCoord);         gl_FragColor *= v_color;     } �AðÒ2–     precision mediump float;     uniform sampler2D u_texture;     varying vec4 v_color;     varying vec2 v_texCoord;         void main()     {         vec4 abgr = texture2D(u_texture, v_texCoord);         gl_FragColor = abgr;         gl_FragColor.r = abgr.b;         gl_FragColor.b = abgr.r;         gl_FragColor *= v_color;     } ����     precision mediump float;     uniform sampler2D u_texture;     varying vec4 v_color;     varying vec2 v_texCoord;         void main()     {         vec4 abgr = texture2D(u_texture, v_texCoord);         gl_FragColor = abgr;         gl_FragColor.r = abgr.b;         gl_FragColor.b = abgr.r;         gl_FragColor.a = 1.0;         gl_FragColor *= v_color;     } ������     precision mediump float;     uniform sampler2D u_texture;     varying vec4 v_color;     varying vec2 v_texCoord;         void main()     {         vec4 abgr = texture2D(u_texture, v_texCoord);         gl_FragColor = abgr;         gl_FragColor.a = 1.0;         gl_FragColor *= v_color;     } ��������precision mediump float;
uniform sampler2D u_texture;
uniform sampler2D u_texture_u;
uniform sampler2D u_texture_v;
varying vec4 v_color;
varying vec2 v_texCoord;

// YUV offset 
const vec3 offset = vec3(0, -0.501960814, -0.501960814);

// RGB coefficients 
const mat3 matrix = mat3( 1,       1,        1,
                          0,      -0.3441,   1.772,
                          1.402,  -0.7141,   0);

void main()
{
    mediump vec3 yuv;
    lowp vec3 rgb;

    // Get the YUV values 
    yuv.x = texture2D(u_texture,   v_texCoord).r;
    yuv.y = texture2D(u_texture_u, v_texCoord).r;
    yuv.z = texture2D(u_texture_v, v_texCoord).r;

    // Do the color transform 
    yuv += offset;
    rgb = matrix * yuv;

    // That was easy. :) 
    gl_FragColor = vec4(rgb, 1);
    gl_FragColor *= v_color;
}�Aá2öprecision mediump float;
uniform sampler2D u_texture;
uniform sampler2D u_texture_u;
